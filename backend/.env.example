APP_NAME=Hushh Identity Exploration API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3002
DATABASE_URL=sqlite:///./identity_exploration.db
SQL_ECHO=false
AUTO_CREATE_TABLES=true
AUTH_ENABLED=false
AUTH_MODE=google_oidc
AUTH_AUDIENCE=
AUTH_ALLOWED_CALLER_EMAILS=
AUTH_API_KEY_HEADER=x-hushh-api-key
AUTH_API_KEYS=
GOOGLE_CLOUD_PROJECT=hushone-app
GOOGLE_CLOUD_LOCATION=global
IDENTITY_EXPLORATION_MODEL=gemini-2.5-pro
IDENTITY_ENABLE_MAPS_GROUNDING=true
MAPS_GEOCODING_BASE_URL=https://geocode.googleapis.com/v4beta
MAPS_LANGUAGE_CODE=en
HTTP_TIMEOUT_SECONDS=20
IDENTITY_JOB_TTL_DAYS=7
IDENTITY_MAX_BATCH_SIZE=10
IDENTITY_MAX_ITEM_ATTEMPTS=3
LOW_ACCURACY_WARNING_THRESHOLD_METERS=100
LOW_CONFIDENCE_WARNING_THRESHOLD=50
STALE_LOCATION_WARNING_DAYS=30
TASK_QUEUE_MODE=disabled
TASK_QUEUE_PROJECT=hushone-app
TASK_QUEUE_LOCATION=us-central1
TASK_QUEUE_NAME=
TASK_QUEUE_SERVICE_ACCOUNT_EMAIL=
WORKER_TARGET_URL=
WORKER_AUDIENCE=
TASK_DISPATCH_DEADLINE_SECONDS=180
CLEANUP_BATCH_SIZE=250
WEB_CONCURRENCY=2
